# Entornos virtuales y variables locales
.venv/
.venv_*/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Credenciales y llaves locales: nunca forman parte del entregable
.credentials/
credentials/
secrets/
credentials.json
secrets.json
application_default_credentials.json
*service-account*.json
*service_account*.json
*.pem
*.key
*.p12
*.pfx

# Cachés y artefactos de Python/Jupyter
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
/*.egg-info/
/build/
/dist/
.coverage
htmlcov/
*.log

# Datos locales: conservar únicamente la estructura mediante .gitkeep
data/**/*
!data/**/
!data/**/.gitkeep
*.parquet
*.arrow
*.feather
*.avro
*.orc
*.csv
*.tsv
*.jsonl
*.ndjson
*.sqlite
*.sqlite3
*.db
*.gz
*.bz2
*.xz
*.zip
*.7z

# Informes, salidas y archivos temporales generados
output/pdf/
output/pdfs/
tmp/pdfs/
informe_p2/
/reports/**/*.pdf

# Publicar únicamente las versiones finales de la presentación
/presentation/output/*
!/presentation/output/Lumina_P3_15min.pptx
!/presentation/output/Lumina_P3_15min.pdf

# Material de evaluación de uso local: rúbricas y observaciones del docente
/referencias_locales/

# Fixtures sintéticos versionables
!/tests/fixtures/*.jsonl

# Terraform: conservar .tf, ejemplos y .terraform.lock.hcl
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
crash.log
crash.*.log

# Archivos locales del sistema y editores
.DS_Store
Thumbs.db
.idea/
.vscode/
